# Copy to .env (never committed) or export these in your shell.
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# consumers = personal Microsoft accounts; organizations = any work account; or your tenant id
GRAPH_TENANT=consumers
# device = a person signs in once; app = client credentials (business tenant only)
GRAPH_AUTH=device
# only for GRAPH_AUTH=app; keep it in a secret store, not in this file
GRAPH_CLIENT_SECRET=
ANTHROPIC_API_KEY=
